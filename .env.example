# ==============================================================================
# CODEWORLD - RENDER DEPLOYMENT ENVIRONMENT CONFIGURATION (EXAMPLE)
# ==============================================================================
# Copy these values into the Render Dashboard's Environment Variables settings.

# 1. Environment Mode
NODE_ENV=production

# 2. Server Port (Render will automatically bind to this)
PORT=10000

# 3. HTTPS Database Bridge URL (Render → Cloudflare → Home Server)
DB_BRIDGE_URL=https://nobasstorage.online/query

# 4. Bridge Server Shared Secret
BRIDGE_SECRET=codeworld_bridge_secret_key_2026

# 5. Cloudflare Access Service Token (Required for Tunnel Authentication)
CF_CLIENT_ID=fb46f0e4aa7e748064cc377ced73e560.access
CF_CLIENT_SECRET=194d3a32761729ee5360d5fe0a579b2458266a43e0de287ac9cc2717d2d3d435

# 6. Local Authentication Cookie Signature Secret
SESSION_SECRET=codeworld_local_super_secret_session_key_123

# 7. Judge0 Compilation Service API URL
NEXT_PUBLIC_JUDGE0_API_URL=https://judge0myownserver.store
