# ==============================================================================
# CODEWORLD - RENDER DEPLOYMENT ENVIRONMENT CONFIGURATION (EXAMPLE)
# ==============================================================================
# Copy these values into the Render Dashboard's Environment Variables settings.

# 1. Environment Mode
NODE_ENV=production

# 2. Server Port (Render will automatically bind to this)
PORT=10000

# 3. Production MariaDB Database Connection String
# Route through your Cloudflare Tunnel public domain (e.g. nobasstorage.online)
DATABASE_URL=mysql://nextcloud:cloud_1q2w3e4r5t@nobasstorage.online:3306/my_migrated_app

# 4. Local Authentication Cookie Signature Secret
# Generate a highly secure, long random string for production sessions.
SESSION_SECRET=codeworld_local_super_secret_session_key_123

# 5. Judge0 Compilation Service API URL
NEXT_PUBLIC_JUDGE0_API_URL=https://judge0myownserver.store

# 6. Cloudflare Access Service Token (Required for Production Tunnel Bypass)
CF_CLIENT_ID=your_cloudflare_access_service_token_client_id
CF_CLIENT_SECRET=your_cloudflare_access_service_token_client_secret
